// StudentOS AI — database schema
// Provider: PostgreSQL. Generated client is consumed by the Next.js app
// via src/server/db.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  DISCORD
}

enum AssignmentStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  SUBMITTED
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

enum StudySessionType {
  POMODORO
  DEEP_WORK
  REVIEW
  CLASS
  BREAK
}

enum ScheduleBlockType {
  CLASS
  STUDY
  FOCUS
  EXAM
  BREAK
  PERSONAL
}

enum NotificationType {
  ASSIGNMENT_DUE
  ASSIGNMENT_OVERDUE
  SCHEDULE_REMINDER
  FLASHCARD_REVIEW
  GROUP_INVITE
  GROUP_MESSAGE
  FRIEND_REQUEST
  ACHIEVEMENT_UNLOCKED
  SYSTEM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum GroupRole {
  OWNER
  MODERATOR
  MEMBER
}

enum ChannelType {
  TEXT
  ANNOUNCEMENT
  DIRECT
}

enum AiFeature {
  CHAT
  HOMEWORK_HELPER
  STUDY_PLANNER
  EXAM_SIMULATOR
  QUIZ_GENERATOR
  FLASHCARD_GENERATOR
  SUMMARIZER
  CONCEPT_EXPLAINER
  MOTIVATION_COACH
  REVISION_GENERATOR
  LEARNING_PATH
}

enum AiRole {
  USER
  MODEL
  SYSTEM
}

enum Theme {
  DARK
  LIGHT
  SYSTEM
}

enum SharePermission {
  VIEW
  COMMENT
  EDIT
}

/// Author-assigned difficulty. Distinct from SM-2 maturity, which is derived
/// from intervalDays at read time.
enum CardDifficulty {
  EASY
  MEDIUM
  HARD
}

enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String  @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  bio          String?
  role         Role    @default(STUDENT)

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Denormalised gamification counters — kept in sync by the streak service.
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  totalXp        Int       @default(0)
  coins          Int       @default(0)
  level          Int       @default(1)
  lastActiveDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  settings           UserSettings?
  accounts           OAuthAccount[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  subjects         Subject[]
  assignments      Assignment[]
  goals            Goal[]
  notes            Note[]
  noteFolders      NoteFolder[]
  decks            FlashcardDeck[]
  cardReviews      FlashcardReview[]
  scheduleBlocks   ScheduleBlock[]
  studySessions    StudySession[]
  dailyStats       DailyStat[]
  notifications    Notification[]
  files            FileAsset[]
  activityLogs     ActivityLog[]
  aiConversations  AiConversation[]
  aiFiles          UploadedFile[]
  aiMemories       AiMemory[]
  dailyBriefs      DailyBrief[]
  tutors           Tutor[]
  userAchievements UserAchievement[]

  groupMemberships GroupMember[]
  ownedGroups      StudyGroup[]  @relation("GroupOwner")
  messages         Message[]

  sentFriendships     Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")

  sharedNotes          NoteShare[]           @relation("NoteSharedWith")
  dailyMissions        DailyMission[]
  weeklyChallenges     WeeklyChallenge[]
  knowledgeCollections KnowledgeCollection[]
  knowledgeDocuments   KnowledgeDocument[]

  @@index([role])
  @@index([deletedAt])
  @@index([lastActiveDate])
  @@index([totalXp(sort: Desc)])
  @@map("users")
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme    Theme  @default(DARK)
  locale   String @default("en")
  timezone String @default("UTC")

  pomodoroWorkMinutes        Int @default(25)
  pomodoroBreakMinutes       Int @default(5)
  pomodoroLongBreakMinutes   Int @default(15)
  pomodoroCyclesPerLongBreak Int @default(4)

  dailyStudyGoalMinutes Int     @default(120)
  weekStartsOnMonday    Boolean @default(true)

  emailNotifications  Boolean @default(true)
  pushNotifications   Boolean @default(true)
  reminderLeadMinutes Int     @default(30)

  aiModel String @default("gemini-2.5-flash")
  aiTone  String @default("encouraging")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model OAuthAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          OAuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 of the raw token. The raw value is never persisted.
  tokenHash  String    @unique
  family     String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  // "EMAIL_VERIFICATION" | "PASSWORD_RESET" | "TWO_FACTOR"
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Academic core
// ---------------------------------------------------------------------------

model Subject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  color       String  @default("#8b5cf6")
  icon        String?
  teacherName String?
  room        String?
  credits     Float?
  targetGrade Float?
  archived    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments    Assignment[]
  notes          Note[]
  decks          FlashcardDeck[]
  scheduleBlocks ScheduleBlock[]
  studySessions  StudySession[]
  goals          Goal[]

  @@unique([userId, name])
  @@index([userId, archived])
  @@map("subjects")
}

model Assignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  title       String
  description String?
  status      AssignmentStatus @default(TODO)
  priority    Priority         @default(MEDIUM)

  dueAt       DateTime?
  startAt     DateTime?
  completedAt DateTime?

  estimatedMinutes Int?
  actualMinutes    Int  @default(0)
  progress         Int  @default(0)

  grade    Float?
  maxGrade Float?
  weight   Float?

  labels String[] @default([])

  // Recurrence — null frequency means a one-off assignment.
  recurrence         RecurrenceFrequency?
  recurrenceInterval Int?
  recurrenceUntil    DateTime?
  parentAssignmentId String?
  parentAssignment   Assignment?          @relation("AssignmentRecurrence", fields: [parentAssignmentId], references: [id], onDelete: Cascade)
  occurrences        Assignment[]         @relation("AssignmentRecurrence")

  reminderAt   DateTime?
  reminderSent Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  attachments    FileAsset[]
  studySessions  StudySession[]
  scheduleBlocks ScheduleBlock[]

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, deletedAt])
  @@index([subjectId])
  @@map("assignments")
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  title        String
  description  String?
  status       GoalStatus @default(ACTIVE)
  targetValue  Float
  currentValue Float      @default(0)
  unit         String     @default("hours")
  dueAt        DateTime?
  achievedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("goals")
}

// ---------------------------------------------------------------------------
// Notes
// ---------------------------------------------------------------------------

model NoteFolder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  color    String?
  parentId String?
  parent   NoteFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NoteFolder[] @relation("FolderTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes Note[]

  @@index([userId, parentId])
  @@map("note_folders")
}

model Note {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  folderId  String?
  folder    NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  title       String
  // Markdown source of record. `contentJson` holds the editor's rich AST.
  content     String  @default("")
  contentJson Json?
  excerpt     String?

  tags      String[] @default([])
  pinned    Boolean  @default(false)
  favorite  Boolean  @default(false)
  wordCount Int      @default(0)

  aiSummary   String?
  aiSummaryAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  attachments FileAsset[]
  decks       FlashcardDeck[]
  versions    NoteVersion[]
  shares      NoteShare[]

  @@index([userId, deletedAt])
  @@index([userId, updatedAt])
  @@index([userId, favorite])
  @@index([userId, archivedAt])
  @@index([folderId])
  @@map("notes")
}

/// Immutable snapshot of a note's content, written before each overwrite.
model NoteVersion {
  id     String @id @default(cuid())
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  title     String
  content   String
  wordCount Int     @default(0)
  /// Monotonic per note, so versions order without relying on timestamps.
  version   Int
  /// Set when a save was triggered by autosave rather than an explicit save.
  automatic Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([noteId, version])
  @@index([noteId, createdAt])
  @@map("note_versions")
}

model NoteShare {
  id     String @id @default(cuid())
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  /// Null for link-based shares that are not bound to an account.
  sharedWithId String?
  sharedWith   User?   @relation("NoteSharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  permission SharePermission @default(VIEW)
  /// Random token for unauthenticated link access; null disables link sharing.
  linkToken  String?         @unique
  expiresAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([noteId, sharedWithId])
  @@index([sharedWithId])
  @@map("note_shares")
}

// ---------------------------------------------------------------------------
// Flashcards — SM-2 spaced repetition
// ---------------------------------------------------------------------------

model FlashcardDeck {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sourceNoteId String?
  sourceNote   Note?    @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)

  name          String
  description   String?
  color         String  @default("#14b8a6")
  isPublic      Boolean @default(false)
  generatedByAi Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards Flashcard[]

  @@index([userId])
  @@map("flashcard_decks")
}

model Flashcard {
  id     String        @id @default(cuid())
  deckId String
  deck   FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  front         String
  back          String
  hint          String?
  tags          String[]       @default([])
  difficulty    CardDifficulty @default(MEDIUM)
  suspended     Boolean        @default(false)
  generatedByAi Boolean        @default(false)

  // SM-2 scheduling state.
  state          CardState @default(NEW)
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews FlashcardReview[]

  @@index([deckId])
  @@index([dueAt])
  // Drives the review queue: due, unsuspended cards within a deck.
  @@index([deckId, suspended, dueAt])
  @@map("flashcards")
}

model FlashcardReview {
  id     String    @id @default(cuid())
  cardId String
  card   Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SM-2 quality response, 0..5
  quality    Int
  responseMs Int?

  easeBefore     Float
  easeAfter      Float
  intervalBefore Int
  intervalAfter  Int

  reviewedAt DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([cardId])
  @@map("flashcard_reviews")
}

// ---------------------------------------------------------------------------
// Schedule & focus
// ---------------------------------------------------------------------------

model ScheduleBlock {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  title    String
  type     ScheduleBlockType @default(STUDY)
  startAt  DateTime
  endAt    DateTime
  location String?
  notes    String?
  color    String?

  // Set when the AI planner created or moved this block.
  aiGenerated Boolean @default(false)
  locked      Boolean @default(false)

  recurrence      RecurrenceFrequency?
  recurrenceUntil DateTime?
  parentBlockId   String?
  parentBlock     ScheduleBlock?       @relation("BlockRecurrence", fields: [parentBlockId], references: [id], onDelete: Cascade)
  occurrences     ScheduleBlock[]      @relation("BlockRecurrence")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startAt])
  @@index([assignmentId])
  @@map("schedule_blocks")
}

model StudySession {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  type            StudySessionType @default(POMODORO)
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  durationSeconds Int              @default(0)

  completed     Boolean @default(false)
  interruptions Int     @default(0)
  focusScore    Int?
  ambientSound  String?
  notes         String?

  @@index([userId, startedAt])
  @@index([subjectId])
  @@map("study_sessions")
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

model DailyStat {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Midnight UTC of the day being summarised.
  date DateTime @db.Date

  studySeconds         Int @default(0)
  focusSeconds         Int @default(0)
  sessionsCompleted    Int @default(0)
  assignmentsCompleted Int @default(0)
  cardsReviewed        Int @default(0)
  notesCreated         Int @default(0)
  productivityScore    Int @default(0)
  xpEarned             Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_stats")
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String
  icon        String
  xpReward    Int    @default(0)
  tier        String @default("BRONZE")
  // Machine-readable unlock rule, e.g. { "metric": "streak", "gte": 7 }
  criteria    Json

  createdAt DateTime @default(now())

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  progress   Float     @default(0)
  unlockedAt DateTime?

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ---------------------------------------------------------------------------
// Social
// ---------------------------------------------------------------------------

model StudyGroup {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  slug        String  @unique
  description String?
  avatarUrl   String?
  isPublic    Boolean @default(false)
  inviteCode  String  @unique
  maxMembers  Int     @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  GroupMember[]
  channels Channel[]

  @@index([ownerId])
  @@map("study_groups")
}

model GroupMember {
  id      String     @id @default(cuid())
  groupId String
  group   StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  role       GroupRole @default(MEMBER)
  joinedAt   DateTime  @default(now())
  mutedUntil DateTime?

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Channel {
  id      String      @id @default(cuid())
  groupId String?
  group   StudyGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name  String
  type  ChannelType @default(TEXT)
  topic String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([groupId])
  @@map("channels")
}

model Message {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content   String
  editedAt  DateTime?
  deletedAt DateTime?

  replyToId String?
  replyTo   Message?  @relation("MessageThread", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageThread")

  createdAt DateTime @default(now())

  attachments FileAsset[]

  @@index([channelId, createdAt])
  @@index([authorId])
  @@map("messages")
}

model Friendship {
  id          String @id @default(cuid())
  requesterId String
  requester   User   @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User   @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status      FriendshipStatus @default(PENDING)
  respondedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

// ---------------------------------------------------------------------------
// AI (Gemini)
// ---------------------------------------------------------------------------

model AiConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature AiFeature @default(CHAT)
  title   String    @default("New conversation")
  model   String    @default("gemini-2.5-flash")
  // Feature-specific context, e.g. { "noteId": "...", "subjectId": "..." }
  context Json?
  pinned  Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  messages AiMessage[]
  files    UploadedFile[]

  @@index([userId, feature])
  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiRole
  content String
  // Structured payload for generator features (quiz JSON, flashcard arrays…).
  data    Json?

  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  finishReason     String?

  createdAt DateTime @default(now())

  files UploadedFile[]

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// A file a user attaches to an AI conversation (PDF, DOCX, image, …). The
/// binary lives in object storage; extracted text (for documents) is cached
/// here so the model can be prompted without re-fetching on every turn.
model UploadedFile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A file belongs to either an AI-chat conversation or a tutor conversation.
  // Exactly one of these is set; both nullable so the same table serves both.
  conversationId String?
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  tutorConversationId String?
  tutorConversation   TutorConversation? @relation(fields: [tutorConversationId], references: [id], onDelete: Cascade)

  // Set once the file is referenced by a specific sent message.
  messageId String?
  message   AiMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  filename   String
  mimeType   String
  size       Int
  storageUrl String
  // Cloudinary public id / storage key, for deletion.
  storageKey String?
  kind       UploadedFileKind @default(DOCUMENT)

  // Extracted text for documents; null for images (handed to Gemini natively).
  extractedText String?
  status        UploadedFileStatus @default(PENDING)
  error         String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([tutorConversationId, createdAt])
  @@index([userId])
  @@map("uploaded_files")
}

enum UploadedFileKind {
  DOCUMENT
  IMAGE
}

/// A durable fact the AI has learned about a student (name, university, current
/// subject, weak topics, goals…), recalled into the system prompt so future
/// conversations stay personal. Keyed per user so updates upsert in place.
model AiMemory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stable slug, e.g. "name", "university", "current_subject", "weak_subject".
  key      String
  value    String
  // profile | study | goals | exams | habits | general
  category String @default("general")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId, updatedAt])
  @@map("ai_memories")
}

/// The AI-generated "command center" brief for a given day — priorities,
/// workload estimate, a recommendation and a motivational line — built from the
/// student's real data. Cached once per day so it is generated, not recomputed.
model DailyBrief {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date    DateTime @db.Date
  content Json

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("daily_briefs")
}

enum UploadedFileStatus {
  PENDING
  READY
  FAILED
}

// ---------------------------------------------------------------------------
// Files, notifications, audit
// ---------------------------------------------------------------------------

model FileAsset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  noteId       String?
  note         Note?       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  messageId    String?
  message      Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)

  filename  String
  mimeType  String
  sizeBytes Int
  url       String
  // Cloudinary public_id, required for deletion.
  publicId  String?
  width     Int?
  height    Int?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([assignmentId])
  @@index([noteId])
  @@map("file_assets")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  title    String
  body     String?
  // Deep-link target within the app, e.g. "/assignments/abc123".
  link     String?
  metadata Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// AI Tutors — a dedicated, subject-scoped tutor per student. Each tutor keeps
// its own conversations, files and learning state, so context never leaks
// between subjects (the Maths tutor never sees Physics history).
// ---------------------------------------------------------------------------

enum TutorDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ADAPTIVE
}

/// One subject tutor owned by a student. Created lazily the first time a
/// student opens a subject from the catalogue. `subjectKey` is the catalogue
/// slug (e.g. "mathematics"); custom subjects use a slug derived from the name.
model Tutor {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectKey String
  subject    String
  // Emoji avatar and accent colour, seeded from the catalogue but overridable.
  emoji      String @default("📘")
  accent     String @default("#6366f1")

  difficulty       TutorDifficulty @default(ADAPTIVE)
  // The student's preferred explanation style, in their own words.
  explanationStyle String?
  goals            String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastActiveAt DateTime?

  conversations   TutorConversation[]
  progress        TutorProgress?
  recommendations TutorRecommendation[]
  insights        TutorInsight[]
  sessions        TutorSession[]

  @@unique([userId, subjectKey])
  @@index([userId, lastActiveAt])
  @@map("tutors")
}

model TutorConversation {
  id      String @id @default(cuid())
  tutorId String
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  userId  String

  title  String  @default("New conversation")
  pinned Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  messages TutorMessage[]
  files    UploadedFile[]

  @@index([tutorId, updatedAt])
  @@index([userId])
  @@map("tutor_conversations")
}

model TutorMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiRole
  content String
  // Structured payload for generator turns (quiz JSON, flashcard arrays…).
  data    Json?
  // Whether the student pinned this message, and whether they later edited it.
  pinned  Boolean @default(false)
  edited  Boolean @default(false)

  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  finishReason     String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("tutor_messages")
}

/// The persistent learning state for a tutor — updated incrementally as the
/// student works. One row per tutor. This is the "context memory" the tutor
/// recalls into every prompt.
model TutorProgress {
  id      String @id @default(cuid())
  tutorId String @unique
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  weakTopics   String[] @default([])
  strongTopics String[] @default([])
  // [{ topic, mistake, correctedAt }]
  mistakes     Json     @default("[]")

  // 0–100 self-consistent estimates maintained by the insight generator.
  masteryScore    Float @default(0)
  confidenceScore Float @default(0)

  // Quiz performance, accumulated so an average can be shown without a scan.
  quizzesTaken  Int @default(0)
  quizQuestions Int @default(0)
  quizCorrect   Int @default(0)

  studyMinutes  Int @default(0)
  messagesCount Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("tutor_progress")
}

/// A single actionable recommendation surfaced to the student (e.g. "Revise
/// integration by parts"). Generated by the insight pass; the student can mark
/// it done or dismiss it.
model TutorRecommendation {
  id      String @id @default(cuid())
  tutorId String
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  userId  String

  // daily | revision | practice | study_plan
  kind  String  @default("daily")
  title String
  body  String?
  done  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([tutorId, createdAt])
  @@map("tutor_recommendations")
}

/// A cached, AI-generated analysis snapshot for a tutor: today's
/// recommendation, weak topics, suggested revision, estimated mastery and a
/// confidence score. Regenerated on demand rather than recomputed per request.
model TutorInsight {
  id      String @id @default(cuid())
  tutorId String
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  userId  String

  // { todaysRecommendation, weakTopics[], suggestedRevision, estimatedMastery, confidenceScore, summary }
  content Json

  createdAt DateTime @default(now())

  @@index([tutorId, createdAt])
  @@map("tutor_insights")
}

/// A study session with a tutor — a bounded window of interaction, used to
/// power "last conversation" and to accumulate study minutes for progress.
model TutorSession {
  id      String @id @default(cuid())
  tutorId String
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  userId  String

  conversationId String?
  topic          String?
  messageCount   Int     @default(0)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([tutorId, startedAt])
  @@map("tutor_sessions")
}

// ---------------------------------------------------------------------------
// Knowledge Base
// ---------------------------------------------------------------------------

model KnowledgeCollection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  color       String  @default("#6366f1")
  icon        String  @default("folder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents KnowledgeDocument[]

  @@index([userId])
  @@map("knowledge_collections")
}

model KnowledgeDocument {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  collectionId String?
  collection   KnowledgeCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  filename      String
  mimeType      String
  sizeBytes     Int
  storageUrl    String
  storageKey    String
  tags          String[]
  extractedText String?

  chunkCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@index([userId])
  @@index([collectionId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String
  pageNumber Int?
  heading    String?

  createdAt DateTime @default(now())

  @@index([documentId, chunkIndex])
  @@map("knowledge_chunks")
}

// ---------------------------------------------------------------------------
// Gamification — Daily Missions & Weekly Challenges
// ---------------------------------------------------------------------------

model DailyMission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime  @db.Date
  missionKey  String
  title       String
  description String
  icon        String    @default("target")
  xpReward    Int       @default(25)
  coinReward  Int       @default(10)
  targetValue Int       @default(1)
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, date, missionKey])
  @@index([userId, date])
  @@map("daily_missions")
}

model WeeklyChallenge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStart    DateTime  @db.Date
  challengeKey String
  title        String
  description  String
  icon         String    @default("trophy")
  xpReward     Int       @default(200)
  coinReward   Int       @default(100)
  targetValue  Int       @default(1)
  progress     Int       @default(0)
  completed    Boolean   @default(false)
  completedAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, weekStart, challengeKey])
  @@index([userId, weekStart])
  @@map("weekly_challenges")
}
