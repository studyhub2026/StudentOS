# Same-origin API — no NEXT_PUBLIC_API_URL needed unless the API is split out.
# NEXT_PUBLIC_API_URL=

# --- Database ---
# DATABASE_URL=postgresql://user:password@localhost:5432/omnelos
# DIRECT_URL=postgresql://user:password@localhost:5432/omnelos

# --- Auth ---
# JWT_ACCESS_SECRET=<64+ hex chars>
# JWT_REFRESH_SECRET=<64+ hex chars>
# APP_URL=http://localhost:3000

# --- Redis (BullMQ, University Sync) ---
# REDIS_URL=redis://localhost:6379
# LMS_WORKER_IN_WEB=true            # false → run standalone `npm run worker`
# LMS_WORKER_CONCURRENCY=4

# --- Canvas LMS OAuth ---
# Register a Canvas developer key at your Canvas admin console.
# Redirect URI must be: {APP_URL}/api/v1/university/oauth/canvas/callback
# CANVAS_CLIENT_ID=
# CANVAS_CLIENT_SECRET=

# --- Moodle username/password token exchange ---
# Service shortname enabled for external Web Services on this Moodle install.
# 'moodle_mobile_app' is the default and works on almost every deployment.
# Override only if your institution disables the mobile service and exposes a
# different one (e.g. 'student_service').
# MOODLE_SERVICE_SHORTNAME=moodle_mobile_app
