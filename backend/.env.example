# ---------------------------------------------------------------------------
# StudentOS AI — backend environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database -------------------------------------------------------------
# Hosted Postgres (Neon / Supabase / Railway). Must include ?sslmode=require
# for most hosted providers.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Redis (optional) -----------------------------------------------------
# Leave blank to run without Redis; the app falls back to in-process caching
# and a memory-backed rate limiter. Required for multi-instance deployments.
REDIS_URL=

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-64-byte-random-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-64-byte-random-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie scope for the refresh token. Depends on how you deploy:
#   - Same origin, or frontend + API on subdomains of one domain:
#       COOKIE_SAMESITE=lax  and  COOKIE_DOMAIN=.yourdomain.com
#   - Split across different domains (Vercel frontend + Railway/Render API):
#       COOKIE_SAMESITE=none and  COOKIE_DOMAIN=   (leave empty)
# Locally, leave both at their defaults.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# --- AI (Google Gemini — the only permitted provider) ---------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# --- OAuth ----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Storage (Cloudinary) -------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
