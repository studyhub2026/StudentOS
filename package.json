{
  "name": "studentos-ai",
  "version": "0.1.0",
  "private": true,
  "description": "StudentOS AI — an AI-powered academic operating system",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=frontend",
    "prisma:generate": "npm run prisma:generate --workspace=frontend",
    "prisma:push": "npm run prisma:push --workspace=frontend",
    "prisma:seed": "npm run prisma:seed --workspace=frontend",
    "prisma:studio": "npm run prisma:studio --workspace=frontend",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "//overrides": "Next 15.5.x pins vulnerable transitive deps: postcss <8.5.10 (GHSA-qx2v-qp2m-jg93) and sharp <0.35.0 (libvips CVE-2026-33327/33328/35590/35591, reachable via next/image). Both are patched here without leaving the Next 15 line. Re-check on each Next upgrade.",
  "overrides": {
    "postcss": "^8.5.22",
    "sharp": "^0.35.3"
  }
}
